# ==================================================
# musicOS_v2
# iPod Video 5 / 5.5G - 320x240
# ==================================================

%wd


# ==================================================
# PRELOADS
# ==================================================

# Lossless
%xl(H,lossless.bmp,0,0)

# Progress bar backdrop
%xl(pb_backdrop,pb_backdrop.bmp,0,0)

# Battery states
%xl(J,batt_status.bmp,0,4,10)

# Volume bar assets
%xl(vb_backdrop,vb_backdrop.bmp,0,0)
%xl(speaker_loud,speaker_loud.bmp,285,1)

%xl(K,playback_modes_musicOS_final.bmp,0,0,10)


# ==================================================
# LOGIC
# ==================================================

# Album art state
%?mp<|%Vd(playing)|%Vd(paused)|%Vd(playing)>

# Progress bar / Volume bar
%?mv(1.2)<%Vd(volumebar)|%Vd(pb)%Vd(elapsed)%Vd(remaining)>

# Lock state
%?mh<%Vd(locked)>

# Lossless state
%?or(%if(%fc, =, 4),%if(%fc, =, 5),%if(%fc, =, 7),%if(%fc, =, 11),%if(%fc, =, 13))<%Vd(lossless)>


# ==================================================
# BACKGROUND
# ==================================================

%V(0,0,-,-,-)%VB
%x(WPSBackdrop,backdrop.bmp,0,0)


# ==================================================
# FONTS
# ==================================================

%Fl(2,14-SunghyunSansDisambiguated-SemiBold.fnt)
%Fl(3,20-SunghyunSansDisambiguated-SemiBold.fnt)
%Fl(4,16-SunghyunSansDisambiguated-SemiBold.fnt)
%Fl(5,28-SunghyunSansDisambiguated-SemiBold.fnt)


# ==================================================
# ALBUM ART - BACKGROUND
# ==================================================

%V(8,38,-156,156,-)%VB
%Vf(000000)
%Vb(FFFFFF)
%Cl(0,0,156,156,c,c)
%Cd


# ==================================================
# RETURN TO FOREGROUND
# ==================================================

%V(0,0,-,-,-)


# ==================================================
# LOCK ICON
# ==================================================

%Vl(locked,45,8,15,15,-)
%Vb(FFFFFF)
%x(lock,lock.bmp,3,2)


# ==================================================
# BATTERY ICON
# ==================================================

%V(282,3,27,20,3)
%Vf(000000)
%Vb(FFFFFF)
%?bp<%?bl<%xd(Ja)|%xd(Ja)|%xd(Ja)|%xd(Jb)|%xd(Jb)|%xd(Jb)|%xd(Jb)|%xd(Jc)|%xd(Jc)|%xd(Jc)|%xd(Jc)|%xd(Jc)|%xd(Jc)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Jd)|%xd(Je)|%xd(Je)>|%?bl<%xd(Jf)|%xd(Jf)|%xd(Jf)|%xd(Jg)|%xd(Jg)|%xd(Jg)|%xd(Jg)|%xd(Jh)|%xd(Jh)|%xd(Jh)|%xd(Jh)|%xd(Jh)|%xd(Jh)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Ji)|%xd(Jj)|%xd(Jj)>>


# ==================================================
# BATTERY PERCENTAGE
# ==================================================

%V(242,9,36,16,2)
%Vf(000000)
%Vb(FFFFFF)
%ar%bl%%


# ==================================================
# CLOCK
# ==================================================

%V(11,9,38,16,2)
%Vf(000000)
%Vb(FFFFFF)
%al%cH:%cM


# ==================================================
# TRACK NUMBER / PLAYLIST TOTAL - TOP CENTER
# ==================================================

%V(120,9,80,16,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%ac%pp of %pe


# ==================================================
# ALBUM FRAME - PLAYING
# ==================================================

%Vl(playing,8,38,-156,156,-)
%?C<%x(AlbumFramed,albumFramed.bmp,0,0)>


# ==================================================
# PAUSE OVERLAY
# ==================================================

%Vl(paused,8,38,-156,156,-)
%x(paused,paused.bmp,0,0)


# ==================================================
# PROGRESS BAR - FULL WIDTH
# ==================================================

%Vl(pb,8,207,304,10,-)
%x(pb_left,pb_left.bmp,0,1)
%pb(4,0,296,10,image,pb.bmp,backdrop,pb_backdrop)
%x(pb_right,pb_right.bmp,300,1)


# ==================================================
# ELAPSED / REMAINING TIME
# ==================================================

# Elapsed
%Vl(elapsed,8,220,60,14,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%al%pc

# Remaining
%Vl(remaining,252,220,60,14,2)
%Vf(6F6F6F)
%Vb(FFFFFF)
%ar-%pr


# ==================================================
# VOLUME BAR
# ==================================================

%Vl(volumebar,8,202,304,33,-)
%Vb(FFFFFF)

# Speaker mute
%x(speaker_mute,speaker_mute.bmp,0,4)

# Volume gauge
%pv(18,5,257,9,vb.bmp,backdrop,vb_backdrop)

# Speaker loud
%xd(speaker_loud)

# ==================================================
# TRACK TITLE
# ==================================================

%V(176,58,136,26,3)
%Vf(000000)
%Vb(FFFFFF)
%s%?it<%it|Unknown Title>


# ==================================================
# ARTIST
# ==================================================

%V(176,82,136,26,4)
%Vf(F24E61)
%Vb(FFFFFF)
%s%?ia<%ia|Unknown Artist>


# ==================================================
# ALBUM
# ==================================================

%V(176,103,136,22,4)
%Vf(6F6F6F)
%Vb(FFFFFF)
%s%?id<%id|Unknown Album>

# ==================================================
# LOSSLESS
# ==================================================

%Vl(lossless,128,218,63,17,-)
%xd(Ha)


# ==================================================
# PLAYBACK MODES
# ==================================================

%V(183,156,127,37,-)

%?if(%ps, =, s)<%?mm<%xd(Kb)|%xd(Kd)|%xd(Kf)|%xd(Kh)|%xd(Kj)>|%?mm<%xd(Ka)|%xd(Kc)|%xd(Ke)|%xd(Kg)|%xd(Ki)>>
