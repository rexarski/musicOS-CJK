# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# In Rockbox skins and theme configs, whitespace and line breaks can be
# rendered on screen, so editors must leave them exactly as written.
[*.{wps,sbs,fms,cfg}]
insert_final_newline = unset
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
